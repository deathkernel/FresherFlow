# Application environment
FRESHERFLOW_ENV=development
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-in-production

# Required for admin login. Generate a Werkzeug password hash and store it here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Required for scheduled public-job sync endpoint when using the deployed sync URL.
PUBLIC_JOB_SYNC_TOKEN=replace-with-a-long-random-token
